  {
    "titulo": "Grupo de planes",
    "html": "<div class=\"ts flex flex-col gap-y-half\" role=\"radiogroup\" aria-label=\"Elegir un plan\">\n  <label for=\"ts-radio-s2\" class=\"ts radio size-md variant-primary\"\n    ><input type=\"radio\" id=\"ts-radio-s2\" name=\"plan\" value=\"individual\" class=\"ts radio-input\" />\n    <div class=\"ts radio-box\"><div class=\"ts radio-dot\"></div></div>\n    <span class=\"ts radio-label\">Individual</span></label\n  >\n  <label for=\"ts-radio-s3\" class=\"ts radio size-md variant-primary is-checked\"\n    ><input\n      type=\"radio\"\n      id=\"ts-radio-s3\"\n      name=\"plan\"\n      checked=\"\"\n      value=\"equipo\"\n      class=\"ts radio-input\"\n    />\n    <div class=\"ts radio-box\"><div class=\"ts radio-dot\"></div></div>\n    <span class=\"ts radio-label\">Equipo</span></label\n  >\n  <label for=\"ts-radio-s4\" class=\"ts radio size-md variant-primary\"\n    ><input type=\"radio\" id=\"ts-radio-s4\" name=\"plan\" value=\"empresa\" class=\"ts radio-input\" />\n    <div class=\"ts radio-box\"><div class=\"ts radio-dot\"></div></div>\n    <span class=\"ts radio-label\">Empresa</span></label\n  >\n</div>"
  },
  {
    "titulo": "Entornos con descripción",
    "html": "<div class=\"ts input-wrapper\">\n  <span id=\"ts-radio-group-root-s5-label\" class=\"ts input-label\">Entorno</span>\n  <div\n    class=\"ts flex flex-col gap-y-half\"\n    role=\"radiogroup\"\n    aria-labelledby=\"ts-radio-group-root-s5-label\"\n    aria-describedby=\"ts-radio-group-root-s5-hint\"\n  >\n    <label for=\"ts-radio-s6\" class=\"ts radio size-md variant-primary has-description\"\n      ><input\n        type=\"radio\"\n        id=\"ts-radio-s6\"\n        name=\"entorno\"\n        value=\"produccion\"\n        class=\"ts radio-input\"\n      />\n      <div class=\"ts radio-box\"><div class=\"ts radio-dot\"></div></div>\n      <span class=\"ts radio-card-body\"\n        ><span class=\"ts radio-label\">Producción</span>\n        <span class=\"ts radio-description\">Visible para todo el equipo.</span></span\n      ></label\n    >\n    <label for=\"ts-radio-s7\" class=\"ts radio size-md variant-primary is-checked has-description\"\n      ><input\n        type=\"radio\"\n        id=\"ts-radio-s7\"\n        name=\"entorno\"\n        checked=\"\"\n        value=\"staging\"\n        class=\"ts radio-input\"\n      />\n      <div class=\"ts radio-box\"><div class=\"ts radio-dot\"></div></div>\n      <span class=\"ts radio-card-body\"\n        ><span class=\"ts radio-label\">Staging</span>\n        <span class=\"ts radio-description\">Para revisar antes de publicar.</span></span\n      ></label\n    >\n    <label for=\"ts-radio-s8\" class=\"ts radio size-md variant-primary is-disabled\"\n      ><input\n        type=\"radio\"\n        id=\"ts-radio-s8\"\n        name=\"entorno\"\n        disabled=\"\"\n        value=\"desarrollo\"\n        class=\"ts radio-input\"\n      />\n      <div class=\"ts radio-box\"><div class=\"ts radio-dot\"></div></div>\n      <span class=\"ts radio-label\">Desarrollo</span></label\n    >\n  </div>\n  <div class=\"ts input-footer\">\n    <div id=\"ts-radio-group-root-s5-hint\" class=\"ts input-hint variant-default\">\n      <span>Se puede cambiar en cada despliegue.</span>\n    </div>\n  </div>\n</div>"
  },
  {
    "titulo": "Opciones en tarjeta",
    "html": "<div class=\"ts input-wrapper\">\n  <span id=\"ts-radio-group-root-s9-label\" class=\"ts input-label\">Facturación</span>\n  <div\n    class=\"ts flex flex-col gap-y-half\"\n    role=\"radiogroup\"\n    aria-labelledby=\"ts-radio-group-root-s9-label\"\n  >\n    <label for=\"ts-radio-s10\" class=\"ts radio size-md variant-primary is-card has-description\"\n      ><input\n        type=\"radio\"\n        id=\"ts-radio-s10\"\n        name=\"facturacion\"\n        value=\"mensual\"\n        class=\"ts radio-input\"\n      />\n      <div class=\"ts radio-box\"><div class=\"ts radio-dot\"></div></div>\n      <span class=\"ts radio-card-body\"\n        ><span class=\"ts radio-label\">Mensual</span>\n        <span class=\"ts radio-description\">Se paga mes a mes.</span></span\n      ></label\n    >\n    <label\n      for=\"ts-radio-s11\"\n      class=\"ts radio size-md variant-primary is-checked is-card has-description\"\n      ><input\n        type=\"radio\"\n        id=\"ts-radio-s11\"\n        name=\"facturacion\"\n        checked=\"\"\n        value=\"anual\"\n        class=\"ts radio-input\"\n      />\n      <div class=\"ts radio-box\"><div class=\"ts radio-dot\"></div></div>\n      <span class=\"ts radio-card-body\"\n        ><span class=\"ts radio-label\">Anual</span>\n        <span class=\"ts radio-description\">Dos meses de regalo.</span></span\n      ></label\n    >\n  </div>\n</div>"
  },
  {
    "titulo": "Obligatorio con error",
    "html": "<div class=\"ts input-wrapper\">\n  <span id=\"ts-radio-group-root-s12-label\" class=\"ts input-label\"\n    >Tu plan<span class=\"ts required-indicator\" aria-hidden=\"true\">*</span></span\n  >\n  <div\n    class=\"ts flex flex-col gap-y-half\"\n    role=\"radiogroup\"\n    aria-labelledby=\"ts-radio-group-root-s12-label\"\n    aria-describedby=\"ts-radio-group-root-s12-hint\"\n    aria-invalid=\"true\"\n    aria-required=\"true\"\n  >\n    <label for=\"ts-radio-s13\" class=\"ts radio size-md variant-danger is-invalid\"\n      ><input\n        type=\"radio\"\n        id=\"ts-radio-s13\"\n        name=\"plan-error\"\n        required=\"\"\n        value=\"free\"\n        class=\"ts radio-input\"\n      />\n      <div class=\"ts radio-box\"><div class=\"ts radio-dot\"></div></div>\n      <span class=\"ts radio-label\">Free</span></label\n    >\n    <label for=\"ts-radio-s14\" class=\"ts radio size-md variant-danger is-invalid\"\n      ><input\n        type=\"radio\"\n        id=\"ts-radio-s14\"\n        name=\"plan-error\"\n        required=\"\"\n        value=\"pro\"\n        class=\"ts radio-input\"\n      />\n      <div class=\"ts radio-box\"><div class=\"ts radio-dot\"></div></div>\n      <span class=\"ts radio-label\">Pro</span></label\n    >\n    <label for=\"ts-radio-s15\" class=\"ts radio size-md variant-danger is-invalid\"\n      ><input\n        type=\"radio\"\n        id=\"ts-radio-s15\"\n        name=\"plan-error\"\n        required=\"\"\n        value=\"enterprise\"\n        class=\"ts radio-input\"\n      />\n      <div class=\"ts radio-box\"><div class=\"ts radio-dot\"></div></div>\n      <span class=\"ts radio-label\">Enterprise</span></label\n    >\n  </div>\n  <div class=\"ts input-footer\">\n    <div id=\"ts-radio-group-root-s12-hint\" class=\"ts input-hint variant-danger\" aria-live=\"polite\">\n      <svg\n        xmlns=\"http://www.w3.org/2000/svg\"\n        width=\"14\"\n        height=\"14\"\n        viewBox=\"0 0 24 24\"\n        fill=\"none\"\n        stroke=\"currentColor\"\n        stroke-width=\"2\"\n        stroke-linecap=\"round\"\n        stroke-linejoin=\"round\"\n        class=\"ts icon icon-14\"\n      >\n        <circle cx=\"12\" cy=\"12\" r=\"10\" />\n        <line x1=\"12\" x2=\"12\" y1=\"8\" y2=\"12\" />\n        <line x1=\"12\" x2=\"12.01\" y1=\"16\" y2=\"16\" />\n      </svg>\n      <span>Hay que elegir un plan para continuar.</span>\n    </div>\n  </div>\n</div>"
  }
]
