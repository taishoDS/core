[
  {
    "titulo": "Paleta de comandos con atajo ⌘K",
    "html": "<button type=\"button\" class=\"ts button size-md variant-secondary\" data-ts-command-open=\"\">\n  Buscar un comando… ⌘K\n</button>\n<div data-ts-listbox=\"command\" data-ts-command-palette=\"\" data-ts-shortcut=\"k\">\n  <dialog\n    data-ts-command-dialog=\"\"\n    closedby=\"any\"\n    class=\"ts command\"\n    aria-label=\"Paleta de comandos\"\n  >\n    <div class=\"ts command-input-wrapper\">\n      <div class=\"ts input-wrapper flex-1\">\n        <div class=\"ts input size-lg variant-bare\" data-ts-input=\"\">\n          <input\n            id=\"ts-input-s2\"\n            value=\"\"\n            type=\"text\"\n            class=\"ts input-field\"\n            data-ts-listbox-input=\"\"\n            placeholder=\"Buscar comandos...\"\n            aria-expanded=\"true\"\n            aria-controls=\"ts-command-list-s1\"\n            role=\"combobox\"\n            aria-autocomplete=\"list\"\n          />\n          <div class=\"ts input-actions\">\n            <span class=\"ts input-loading\" data-ts-field-spinner=\"\" hidden=\"\"\n              ><span class=\"ts spinner size-md\" role=\"status\" aria-label=\"Cargando...\"></span\n            ></span>\n          </div>\n        </div>\n      </div>\n    </div>\n    <div\n      id=\"ts-command-list-s1\"\n      class=\"ts command-list\"\n      data-ts-listbox-panel=\"\"\n      role=\"listbox\"\n      aria-label=\"Resultados\"\n    >\n      <div\n        class=\"ts command-item\"\n        role=\"option\"\n        aria-selected=\"false\"\n        data-ts-value=\"nuevo\"\n        data-ts-keywords=\"crear añadir\"\n      >\n        <span data-cmd-text=\"\"><span data-cmd-label=\"\">Nuevo archivo</span></span>\n      </div>\n      <div\n        class=\"ts command-item\"\n        role=\"option\"\n        aria-selected=\"false\"\n        data-ts-value=\"abrir\"\n        data-ts-keywords=\"cargar\"\n      >\n        <span data-cmd-text=\"\"><span data-cmd-label=\"\">Abrir proyecto</span></span>\n      </div>\n      <div\n        class=\"ts command-item\"\n        role=\"option\"\n        aria-selected=\"false\"\n        data-ts-value=\"ajustes\"\n        data-ts-keywords=\"config\"\n      >\n        <span data-cmd-text=\"\"><span data-cmd-label=\"\">Preferencias</span></span>\n      </div>\n    </div>\n    <div\n      class=\"ts command-empty\"\n      data-ts-listbox-empty=\"\"\n      data-ts-empty-for='Sin resultados para \"{q}\"'\n      hidden=\"\"\n    >\n      No hay comandos disponibles\n    </div>\n  </dialog>\n</div>"
  },
  {
    "titulo": "Paleta sin comandos",
    "html": "<p class=\"ts type-copy-14 color-subtle\">\n  Sin comandos: probar <kbd class=\"ts kbd\">⌘</kbd> <kbd class=\"ts kbd\">J</kbd>.\n</p>\n<div data-ts-listbox=\"command\" data-ts-command-palette=\"\" data-ts-shortcut=\"j\">\n  <dialog\n    data-ts-command-dialog=\"\"\n    closedby=\"any\"\n    class=\"ts command\"\n    aria-label=\"Paleta de comandos\"\n  >\n    <div class=\"ts command-input-wrapper\">\n      <div class=\"ts input-wrapper flex-1\">\n        <div class=\"ts input size-lg variant-bare\" data-ts-input=\"\">\n          <input\n            id=\"ts-input-s4\"\n            value=\"\"\n            type=\"text\"\n            class=\"ts input-field\"\n            data-ts-listbox-input=\"\"\n            placeholder=\"Buscar comandos…\"\n            aria-expanded=\"true\"\n            aria-controls=\"ts-command-list-s3\"\n            role=\"combobox\"\n            aria-autocomplete=\"list\"\n          />\n          <div class=\"ts input-actions\">\n            <span class=\"ts input-loading\" data-ts-field-spinner=\"\" hidden=\"\"\n              ><span class=\"ts spinner size-md\" role=\"status\" aria-label=\"Cargando...\"></span\n            ></span>\n          </div>\n        </div>\n      </div>\n    </div>\n    <div\n      id=\"ts-command-list-s3\"\n      class=\"ts command-list\"\n      data-ts-listbox-panel=\"\"\n      role=\"listbox\"\n      aria-label=\"Resultados\"\n    ></div>\n    <div\n      class=\"ts command-empty\"\n      data-ts-listbox-empty=\"\"\n      data-ts-empty-for='Sin resultados para \"{q}\"'\n      hidden=\"\"\n    >\n      No hay comandos disponibles\n    </div>\n  </dialog>\n</div>"
  }
]
