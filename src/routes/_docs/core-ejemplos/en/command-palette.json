[
  {
    "titulo": "Command palette with ⌘K shortcut",
    "html": "<button type=\"button\" class=\"ts button size-md variant-secondary\" data-ts-command-open=\"\">\n  Search for a command… ⌘K\n</button>\n<div data-ts-listbox=\"command\" data-ts-command-palette=\"\" data-ts-shortcut=\"k\">\n  <dialog data-ts-command-dialog=\"\" closedby=\"any\" class=\"ts command\" aria-label=\"Command palette\">\n    <div class=\"ts command-input-wrapper\">\n      <div class=\"ts input-wrapper flex-1\">\n        <div class=\"ts input size-lg variant-bare\" data-ts-input=\"\">\n          <input\n            id=\"ts-input-s2\"\n            value=\"\"\n            type=\"text\"\n            class=\"ts input-field\"\n            data-ts-listbox-input=\"\"\n            placeholder=\"Search commands…\"\n            aria-expanded=\"true\"\n            aria-controls=\"ts-command-list-s1\"\n            role=\"combobox\"\n            aria-autocomplete=\"list\"\n          />\n          <div class=\"ts input-actions\">\n            <span class=\"ts input-loading\" data-ts-field-spinner=\"\" hidden=\"\"\n              ><span class=\"ts spinner size-md\" role=\"status\" aria-label=\"Loading…\"></span\n            ></span>\n          </div>\n        </div>\n      </div>\n    </div>\n    <div\n      id=\"ts-command-list-s1\"\n      class=\"ts command-list\"\n      data-ts-listbox-panel=\"\"\n      role=\"listbox\"\n      aria-label=\"Results\"\n    >\n      <div\n        class=\"ts command-item\"\n        role=\"option\"\n        aria-selected=\"false\"\n        data-ts-value=\"nuevo\"\n        data-ts-keywords=\"create add\"\n      >\n        <span data-cmd-text=\"\"><span data-cmd-label=\"\">New file</span></span>\n      </div>\n      <div\n        class=\"ts command-item\"\n        role=\"option\"\n        aria-selected=\"false\"\n        data-ts-value=\"abrir\"\n        data-ts-keywords=\"load\"\n      >\n        <span data-cmd-text=\"\"><span data-cmd-label=\"\">Open project</span></span>\n      </div>\n      <div\n        class=\"ts command-item\"\n        role=\"option\"\n        aria-selected=\"false\"\n        data-ts-value=\"ajustes\"\n        data-ts-keywords=\"config\"\n      >\n        <span data-cmd-text=\"\"><span data-cmd-label=\"\">Preferences</span></span>\n      </div>\n    </div>\n    <div\n      class=\"ts command-empty\"\n      data-ts-listbox-empty=\"\"\n      data-ts-empty-for=\"No results for “{q}”\"\n      hidden=\"\"\n    >\n      No commands available\n    </div>\n  </dialog>\n</div>"
  },
  {
    "titulo": "Palette with no commands",
    "html": "<p class=\"ts type-copy-14 color-subtle\">\n  No commands here. Press <kbd class=\"ts kbd\">⌘</kbd> <kbd class=\"ts kbd\">J</kbd>.\n</p>\n<div data-ts-listbox=\"command\" data-ts-command-palette=\"\" data-ts-shortcut=\"j\">\n  <dialog data-ts-command-dialog=\"\" closedby=\"any\" class=\"ts command\" aria-label=\"Command palette\">\n    <div class=\"ts command-input-wrapper\">\n      <div class=\"ts input-wrapper flex-1\">\n        <div class=\"ts input size-lg variant-bare\" data-ts-input=\"\">\n          <input\n            id=\"ts-input-s4\"\n            value=\"\"\n            type=\"text\"\n            class=\"ts input-field\"\n            data-ts-listbox-input=\"\"\n            placeholder=\"Search commands…\"\n            aria-expanded=\"true\"\n            aria-controls=\"ts-command-list-s3\"\n            role=\"combobox\"\n            aria-autocomplete=\"list\"\n          />\n          <div class=\"ts input-actions\">\n            <span class=\"ts input-loading\" data-ts-field-spinner=\"\" hidden=\"\"\n              ><span class=\"ts spinner size-md\" role=\"status\" aria-label=\"Loading…\"></span\n            ></span>\n          </div>\n        </div>\n      </div>\n    </div>\n    <div\n      id=\"ts-command-list-s3\"\n      class=\"ts command-list\"\n      data-ts-listbox-panel=\"\"\n      role=\"listbox\"\n      aria-label=\"Results\"\n    ></div>\n    <div\n      class=\"ts command-empty\"\n      data-ts-listbox-empty=\"\"\n      data-ts-empty-for=\"No results for “{q}”\"\n      hidden=\"\"\n    >\n      No commands available\n    </div>\n  </dialog>\n</div>"
  }
]
