[
  {
    "titulo": "Confirm account deletion",
    "html": "<button\n  type=\"button\"\n  class=\"ts button size-md variant-danger\"\n  commandfor=\"ts-alert-demo\"\n  command=\"show-modal\"\n>\n  Delete account\n</button>\n<dialog\n  id=\"ts-alert-demo\"\n  role=\"alertdialog\"\n  class=\"ts modal-dialog\"\n  aria-labelledby=\"ts-alertdialog-title-s1\"\n  aria-describedby=\"ts-alertdialog-body-s1\"\n>\n  <div class=\"ts modal size-sm\">\n    <div class=\"ts modal-header\">\n      <h2 id=\"ts-alertdialog-title-s1\" class=\"ts modal-title\">Delete your account?</h2>\n    </div>\n    <div id=\"ts-alertdialog-body-s1\" class=\"ts modal-body\">\n      This cannot be undone. All your projects will be lost.\n    </div>\n    <div class=\"ts modal-footer\">\n      <button\n        type=\"button\"\n        class=\"ts button size-md variant-secondary\"\n        data-ts-safe=\"\"\n        commandfor=\"ts-alert-demo\"\n        command=\"close\"\n      >\n        <span data-ts-spinner=\"\"><span class=\"ts spinner size-sm\" aria-hidden=\"true\"></span></span>\n        <span data-ts-content=\"\"> Cancel </span>\n      </button>\n      <button\n        type=\"button\"\n        class=\"ts button size-md variant-danger\"\n        commandfor=\"ts-alert-demo\"\n        command=\"close\"\n      >\n        <span data-ts-spinner=\"\"><span class=\"ts spinner size-sm\" aria-hidden=\"true\"></span></span>\n        <span data-ts-content=\"\"> Yes, delete </span>\n      </button>\n    </div>\n  </div>\n</dialog>"
  },
  {
    "titulo": "Confirm by typing the project name",
    "html": "<button\n  type=\"button\"\n  class=\"ts button size-md variant-danger\"\n  commandfor=\"ts-alert-text-demo\"\n  command=\"show-modal\"\n>\n  Delete project\n</button>\n<dialog\n  id=\"ts-alert-text-demo\"\n  role=\"alertdialog\"\n  class=\"ts modal-dialog\"\n  aria-labelledby=\"ts-alertdialog-title-s2\"\n  aria-describedby=\"ts-alertdialog-body-s2\"\n  data-ts-confirm-text=\"Dashboard\"\n>\n  <div class=\"ts modal size-sm\">\n    <div class=\"ts modal-header\">\n      <h2 id=\"ts-alertdialog-title-s2\" class=\"ts modal-title\">Delete the project?</h2>\n    </div>\n    <div class=\"ts modal-body flex flex-col gap-base\">\n      <div id=\"ts-alertdialog-body-s2\">\n        This deletes the deployments and keys of “Dashboard”. This cannot be undone.\n      </div>\n      <div class=\"ts input-wrapper\">\n        <label for=\"ts-input-s3\" class=\"ts input-label\">Type “Dashboard” to confirm</label>\n        <div class=\"ts input size-md variant-default\" data-ts-input=\"\">\n          <input\n            id=\"ts-input-s3\"\n            value=\"\"\n            type=\"text\"\n            class=\"ts input-field\"\n            autocomplete=\"off\"\n            data-ts-confirm-input=\"\"\n          />\n          <div class=\"ts input-actions\">\n            <span class=\"ts input-loading\" data-ts-field-spinner=\"\" hidden=\"\"\n              ><span class=\"ts spinner size-sm\" role=\"status\" aria-label=\"Loading…\"></span\n            ></span>\n          </div>\n        </div>\n      </div>\n    </div>\n    <div class=\"ts modal-footer\">\n      <button\n        type=\"button\"\n        class=\"ts button size-md variant-secondary\"\n        data-ts-safe=\"\"\n        commandfor=\"ts-alert-text-demo\"\n        command=\"close\"\n      >\n        <span data-ts-spinner=\"\"><span class=\"ts spinner size-sm\" aria-hidden=\"true\"></span></span>\n        <span data-ts-content=\"\"> Cancel </span>\n      </button>\n      <button\n        type=\"button\"\n        disabled=\"\"\n        class=\"ts button size-md variant-danger\"\n        data-ts-confirm=\"\"\n        commandfor=\"ts-alert-text-demo\"\n        command=\"close\"\n      >\n        <span data-ts-spinner=\"\"><span class=\"ts spinner size-sm\" aria-hidden=\"true\"></span></span>\n        <span data-ts-content=\"\"> Delete permanently </span>\n      </button>\n    </div>\n  </div>\n</dialog>"
  },
  {
    "titulo": "A more descriptive name",
    "html": "<button\n  type=\"button\"\n  class=\"ts button size-md variant-danger\"\n  commandfor=\"ts-alert-nombre-demo\"\n  command=\"show-modal\"\n>\n  Remove Carla Ruiz\n</button>\n<dialog\n  id=\"ts-alert-nombre-demo\"\n  role=\"alertdialog\"\n  class=\"ts modal-dialog\"\n  aria-label=\"Remove Carla Ruiz from the Marketing site project\"\n  aria-describedby=\"ts-alertdialog-body-s4\"\n>\n  <div class=\"ts modal size-sm\">\n    <div class=\"ts modal-header\">\n      <h2 id=\"ts-alertdialog-title-s4\" class=\"ts modal-title\">Remove Carla Ruiz?</h2>\n    </div>\n    <div id=\"ts-alertdialog-body-s4\" class=\"ts modal-body\">\n      She loses access to “Marketing site”. She can be invited again whenever needed.\n    </div>\n    <div class=\"ts modal-footer\">\n      <button\n        type=\"button\"\n        class=\"ts button size-md variant-secondary\"\n        data-ts-safe=\"\"\n        commandfor=\"ts-alert-nombre-demo\"\n        command=\"close\"\n      >\n        <span data-ts-spinner=\"\"><span class=\"ts spinner size-sm\" aria-hidden=\"true\"></span></span>\n        <span data-ts-content=\"\"> Cancel </span>\n      </button>\n      <button\n        type=\"button\"\n        class=\"ts button size-md variant-danger\"\n        commandfor=\"ts-alert-nombre-demo\"\n        command=\"close\"\n      >\n        <span data-ts-spinner=\"\"><span class=\"ts spinner size-sm\" aria-hidden=\"true\"></span></span>\n        <span data-ts-content=\"\"> Remove </span>\n      </button>\n    </div>\n  </div>\n</dialog>"
  }
]
