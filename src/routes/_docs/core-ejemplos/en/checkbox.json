      <path d=\"M5 12h14\" /></svg\n      ></span>\n      <span class=\"ts checkbox-label\">SMS</span></label\n    >\n  </div>\n  <div class=\"ts input-footer\">\n    <div id=\"ts-checkbox-group-s10-hint\" class=\"ts input-hint variant-danger\" aria-live=\"polite\">\n      <svg\n        xmlns=\"http://www.w3.org/2000/svg\"\n        width=\"14\"\n        height=\"14\"\n        viewBox=\"0 0 24 24\"\n        fill=\"none\"\n        stroke=\"currentColor\"\n        stroke-width=\"2\"\n        stroke-linecap=\"round\"\n        stroke-linejoin=\"round\"\n        class=\"ts icon icon-14\"\n      >\n        <circle cx=\"12\" cy=\"12\" r=\"10\" />\n        <line x1=\"12\" x2=\"12\" y1=\"8\" y2=\"12\" />\n        <line x1=\"12\" x2=\"12.01\" y1=\"16\" y2=\"16\" />\n      </svg>\n      <span>Choose at least one channel.</span>\n    </div>\n  </div>\n</div>"
