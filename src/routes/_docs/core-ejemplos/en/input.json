  {
    "titulo": "With error",
    "html": "<div class=\"ts input-wrapper\">\n  <label for=\"ts-input-s3\" class=\"ts input-label\">Username</label>\n  <div class=\"ts input size-md variant-danger\" data-ts-input=\"\">\n    <input\n      id=\"ts-input-s3\"\n      value=\"ada\"\n      type=\"text\"\n      class=\"ts input-field\"\n      aria-invalid=\"true\"\n      aria-describedby=\"ts-input-s3-hint\"\n    />\n    <div class=\"ts input-actions\">\n      <span class=\"ts input-loading\" data-ts-field-spinner=\"\" hidden=\"\"\n        ><span class=\"ts spinner size-sm\" role=\"status\" aria-label=\"Loading…\"></span\n      ></span>\n    </div>\n  </div>\n  <div class=\"ts input-footer\">\n    <div id=\"ts-input-s3-hint\" class=\"ts input-hint variant-danger\" aria-live=\"polite\">\n      <svg\n        xmlns=\"http://www.w3.org/2000/svg\"\n        width=\"14\"\n        height=\"14\"\n        viewBox=\"0 0 24 24\"\n        fill=\"none\"\n        stroke=\"currentColor\"\n        stroke-width=\"2\"\n        stroke-linecap=\"round\"\n        stroke-linejoin=\"round\"\n        class=\"ts icon icon-14\"\n      >\n        <circle cx=\"12\" cy=\"12\" r=\"10\" />\n        <line x1=\"12\" x2=\"12\" y1=\"8\" y2=\"12\" />\n        <line x1=\"12\" x2=\"12.01\" y1=\"16\" y2=\"16\" />\n      </svg>\n      <span>That username is taken. Try another one.</span>\n    </div>\n  </div>\n</div>"
  },
  {
    "titulo": "With a leading icon",
    "html": "<div class=\"ts input-wrapper\">\n  <label for=\"ts-input-s4\" class=\"ts input-label\">Search</label>\n  <div class=\"ts input size-md variant-default\" data-ts-input=\"\">\n    <div class=\"ts input-prefix-block\">\n      <svg\n        xmlns=\"http://www.w3.org/2000/svg\"\n        width=\"16\"\n        height=\"16\"\n        viewBox=\"0 0 24 24\"\n        fill=\"none\"\n        stroke=\"currentColor\"\n        stroke-width=\"2\"\n        stroke-linecap=\"round\"\n        stroke-linejoin=\"round\"\n        class=\"ts icon icon-16\"\n      >\n        <path d=\"m21 21-4.34-4.34\" />\n        <circle cx=\"11\" cy=\"11\" r=\"8\" />\n      </svg>\n    </div>\n    <input\n      id=\"ts-input-s4\"\n      value=\"\"\n      type=\"text\"\n      class=\"ts input-field\"\n      placeholder=\"Search the project\"\n    />\n    <div class=\"ts input-actions\">\n      <span class=\"ts input-loading\" data-ts-field-spinner=\"\" hidden=\"\"\n        ><span class=\"ts spinner size-sm\" role=\"status\" aria-label=\"Loading…\"></span\n      ></span>\n    </div>\n  </div>\n</div>"
  },
  {
