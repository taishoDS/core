  {
    "titulo": "Field with label and placeholder",
    "html": "<div class=\"ts input-wrapper\">\n  <label for=\"ts-input-s1\" class=\"ts input-label\">Name</label>\n  <div class=\"ts input size-md variant-default\" data-ts-input=\"\">\n    <input\n      id=\"ts-input-s1\"\n      value=\"\"\n      type=\"text\"\n      class=\"ts input-field\"\n      placeholder=\"Ada Lovelace\"\n    />\n    <div class=\"ts input-actions\">\n      <span class=\"ts input-loading\" data-ts-field-spinner=\"\" hidden=\"\"\n        ><span class=\"ts spinner size-sm\" role=\"status\" aria-label=\"Loading…\"></span\n      ></span>\n    </div>\n  </div>\n</div>"
