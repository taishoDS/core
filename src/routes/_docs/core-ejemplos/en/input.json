  {
    "titulo": "Clearable",
    "html": "<div class=\"ts input-wrapper\">\n  <label for=\"ts-input-s6\" class=\"ts input-label\">Project</label>\n  <div class=\"ts input size-md variant-default\" data-ts-input=\"\">\n    <input id=\"ts-input-s6\" value=\"Dashboard\" type=\"text\" class=\"ts input-field\" />\n    <div class=\"ts input-actions\">\n      <span class=\"ts input-loading\" data-ts-field-spinner=\"\" hidden=\"\"\n        ><span class=\"ts spinner size-sm\" role=\"status\" aria-label=\"Loading…\"></span\n      ></span>\n      <button\n        type=\"button\"\n        class=\"ts button size-xs variant-tertiary shape-square is-icon-only\"\n        aria-label=\"Clear field\"\n        data-ts-clear=\"\"\n      >\n        <span data-ts-spinner=\"\"><span class=\"ts spinner size-sm\" aria-hidden=\"true\"></span></span>\n        <span data-ts-content=\"\">\n          <svg\n            xmlns=\"http://www.w3.org/2000/svg\"\n            width=\"16\"\n            height=\"16\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n            stroke-linecap=\"round\"\n            stroke-linejoin=\"round\"\n            class=\"ts icon icon-16\"\n          >\n            <path d=\"M18 6 6 18\" />\n            <path d=\"m6 6 12 12\" />\n          </svg>\n        </span>\n      </button>\n    </div>\n  </div>\n</div>"
  },
  {
    "titulo": "Loading",
    "html": "<div class=\"ts input-wrapper\">\n  <label for=\"ts-input-s7\" class=\"ts input-label\">Invite</label>\n  <div class=\"ts input size-md variant-default is-loading\" data-ts-input=\"\">\n    <input\n      id=\"ts-input-s7\"\n      value=\"bruno.diaz\"\n      type=\"text\"\n      class=\"ts input-field\"\n      aria-busy=\"true\"\n    />\n    <div class=\"ts input-actions\">\n      <span class=\"ts input-loading\" data-ts-field-spinner=\"\"\n        ><span class=\"ts spinner size-sm\" role=\"status\" aria-label=\"Loading…\"></span\n      ></span>\n      <button\n        type=\"button\"\n        class=\"ts button size-xs variant-tertiary shape-square is-icon-only\"\n        aria-label=\"Clear field\"\n        data-ts-clear=\"\"\n      >\n        <span data-ts-spinner=\"\"><span class=\"ts spinner size-sm\" aria-hidden=\"true\"></span></span>\n        <span data-ts-content=\"\">\n          <svg\n            xmlns=\"http://www.w3.org/2000/svg\"\n            width=\"16\"\n            height=\"16\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n            stroke-linecap=\"round\"\n            stroke-linejoin=\"round\"\n            class=\"ts icon icon-16\"\n          >\n            <path d=\"M18 6 6 18\" />\n            <path d=\"m6 6 12 12\" />\n          </svg>\n        </span>\n      </button>\n    </div>\n  </div>\n</div>"
