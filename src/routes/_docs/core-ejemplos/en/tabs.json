    "titulo": "Tabs with three panels",
    "html": "<div data-ts-tabs=\"\" class=\"ts w-full\">\n  <div\n    role=\"tablist\"\n    aria-orientation=\"horizontal\"\n    class=\"ts tabs variant-default orientation-horizontal\"\n  >\n    <button\n      type=\"button\"\n      role=\"tab\"\n      id=\"ts-tabs-s1-tab-resumen\"\n      aria-controls=\"ts-tabs-s1-panel-resumen\"\n      aria-selected=\"true\"\n      tabindex=\"0\"\n      data-ts-tabs-tab=\"\"\n      data-ts-value=\"resumen\"\n      class=\"ts tabs-tab is-active\"\n    >\n      Overview\n    </button>\n    <button\n      type=\"button\"\n      role=\"tab\"\n      id=\"ts-tabs-s1-tab-actividad\"\n      aria-controls=\"ts-tabs-s1-panel-actividad\"\n      aria-selected=\"false\"\n      tabindex=\"-1\"\n      data-ts-tabs-tab=\"\"\n      data-ts-value=\"actividad\"\n      class=\"ts tabs-tab\"\n    >\n      Activity\n    </button>\n    <button\n      type=\"button\"\n      role=\"tab\"\n      id=\"ts-tabs-s1-tab-ajustes\"\n      aria-controls=\"ts-tabs-s1-panel-ajustes\"\n      aria-selected=\"false\"\n      tabindex=\"-1\"\n      data-ts-tabs-tab=\"\"\n      data-ts-value=\"ajustes\"\n      class=\"ts tabs-tab\"\n    >\n      Settings\n    </button>\n  </div>\n  <div\n    role=\"tabpanel\"\n    id=\"ts-tabs-s1-panel-resumen\"\n    aria-labelledby=\"ts-tabs-s1-tab-resumen\"\n    tabindex=\"0\"\n    data-ts-tabs-panel=\"\"\n    data-ts-value=\"resumen\"\n    class=\"ts py-base\"\n  >\n    This month’s sales compared with last month.\n  </div>\n  <div\n    role=\"tabpanel\"\n    id=\"ts-tabs-s1-panel-actividad\"\n    aria-labelledby=\"ts-tabs-s1-tab-actividad\"\n    tabindex=\"0\"\n    data-ts-tabs-panel=\"\"\n    data-ts-value=\"actividad\"\n    class=\"ts py-base\"\n  >\n    Recent account activity.\n  </div>\n  <div\n    role=\"tabpanel\"\n    id=\"ts-tabs-s1-panel-ajustes\"\n    aria-labelledby=\"ts-tabs-s1-tab-ajustes\"\n    tabindex=\"0\"\n    data-ts-tabs-panel=\"\"\n    data-ts-value=\"ajustes\"\n    class=\"ts py-base\"\n  >\n    Notification preferences.\n  </div>\n</div>"
