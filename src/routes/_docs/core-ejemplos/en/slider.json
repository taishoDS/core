[
  {
    "titulo": "Plan seat limit",
    "html": "<div class=\"ts max-w-screen-sm\">\n  <div class=\"ts slider size-md\" data-ts-slider=\"\">\n    <div class=\"ts slider-header\">\n      <label class=\"ts slider-label\" id=\"ts-slider-s1-label\" for=\"ts-slider-s1\">Seat limit</label>\n    </div>\n    <input\n      id=\"ts-slider-s1\"\n      type=\"range\"\n      class=\"ts slider-track size-md\"\n      min=\"0\"\n      max=\"100\"\n      step=\"1\"\n      value=\"40\"\n      aria-label=\"Seat limit\"\n      aria-valuemin=\"0\"\n      aria-valuemax=\"100\"\n      aria-valuenow=\"40\"\n    />\n  </div>\n</div>"
  },
  {
    "titulo": "Price range",
    "html": "<div\n  class=\"ts slider size-md is-range\"\n  data-ts-slider=\"\"\n  data-ts-slider-range=\"\"\n  data-ts-slider-format=\"{v} USD\"\n  role=\"group\"\n  aria-labelledby=\"ts-slider-s2-label\"\n>\n  <div class=\"ts slider-header\">\n    <label class=\"ts slider-label\" id=\"ts-slider-s2-label\" for=\"ts-slider-s2\">Price range</label>\n    <span class=\"ts slider-value\" data-ts-slider-value=\"\">⁨20 USD⁩ – ⁨80 USD⁩</span>\n  </div>\n  <div class=\"ts slider-range size-md\" data-ts-slider-rail=\"\">\n    <input\n      id=\"ts-slider-s2\"\n      type=\"range\"\n      class=\"ts slider-track size-md is-start\"\n      min=\"0\"\n      max=\"100\"\n      step=\"5\"\n      name=\"precio-desde\"\n      value=\"20\"\n      data-ts-slider-thumb=\"0\"\n      aria-label=\"Minimum\"\n      aria-labelledby=\"ts-slider-s2-label ts-slider-s2\"\n      aria-valuemin=\"0\"\n      aria-valuemax=\"80\"\n      aria-valuenow=\"20\"\n      aria-valuetext=\"20 USD\"\n    />\n    <input\n      id=\"ts-slider-s2-end\"\n      type=\"range\"\n      class=\"ts slider-track size-md is-end\"\n      min=\"0\"\n      max=\"100\"\n      step=\"5\"\n      name=\"precio-hasta\"\n      value=\"80\"\n      data-ts-slider-thumb=\"1\"\n      aria-label=\"Maximum\"\n      aria-labelledby=\"ts-slider-s2-label ts-slider-s2-end\"\n      aria-valuemin=\"20\"\n      aria-valuemax=\"100\"\n      aria-valuenow=\"80\"\n      aria-valuetext=\"80 USD\"\n    />\n  </div>\n  <div class=\"ts slider-marks\"><span>0</span> <span>100</span></div>\n</div>"
  },
  {
    "titulo": "Vertical",
    "html": "<div class=\"ts slider size-md is-vertical\" data-ts-slider=\"\" data-ts-slider-format=\"{v}%\">\n  <div class=\"ts slider-header\">\n    <label class=\"ts slider-label\" id=\"ts-slider-s3-label\" for=\"ts-slider-s3\">Capacity</label>\n    <span class=\"ts slider-value\" data-ts-slider-value=\"\">60%</span>\n  </div>\n  <input\n    id=\"ts-slider-s3\"\n    type=\"range\"\n    class=\"ts slider-track size-md\"\n    min=\"0\"\n    max=\"100\"\n    step=\"1\"\n    value=\"60\"\n    aria-label=\"Capacity\"\n    aria-valuemin=\"0\"\n    aria-valuemax=\"100\"\n    aria-valuenow=\"60\"\n    aria-valuetext=\"60%\"\n    aria-orientation=\"vertical\"\n  />\n</div>"
  },
  {
    "titulo": "Read-only",
    "html": "<div class=\"ts slider size-md is-readonly\" data-ts-slider=\"\" data-ts-slider-format=\"{v}%\">\n  <div class=\"ts slider-header\">\n    <label class=\"ts slider-label\" id=\"ts-slider-s4-label\" for=\"ts-slider-s4\">Usage quota</label>\n    <span class=\"ts slider-value\" data-ts-slider-value=\"\">65%</span>\n  </div>\n  <input\n    id=\"ts-slider-s4\"\n    type=\"range\"\n    class=\"ts slider-track size-md\"\n    min=\"0\"\n    max=\"100\"\n    step=\"1\"\n    name=\"cuota-uso\"\n    value=\"65\"\n    aria-label=\"Usage quota\"\n    aria-valuemin=\"0\"\n    aria-valuemax=\"100\"\n    aria-valuenow=\"65\"\n    aria-valuetext=\"65%\"\n    aria-readonly=\"true\"\n  />\n</div>"
  },
  {
    "titulo": "Uneven stops",
    "html": "<div\n  class=\"ts slider size-md\"\n  data-ts-slider=\"\"\n  data-ts-slider-format=\"{v} seats\"\n  data-ts-slider-values=\"5,10,25,50,100,250\"\n>\n  <div class=\"ts slider-header\">\n    <label class=\"ts slider-label\" id=\"ts-slider-s5-label\" for=\"ts-slider-s5\">Plan seats</label>\n    <span class=\"ts slider-value\" data-ts-slider-value=\"\">25 seats</span>\n  </div>\n  <div class=\"ts slider-ticks\" aria-hidden=\"true\">\n    <span></span><span></span><span></span><span></span><span></span><span></span>\n  </div>\n  <input\n    id=\"ts-slider-s5\"\n    type=\"range\"\n    class=\"ts slider-track size-md\"\n    min=\"0\"\n    max=\"5\"\n    step=\"1\"\n    value=\"2\"\n    aria-label=\"Plan seats\"\n    aria-valuemin=\"5\"\n    aria-valuemax=\"250\"\n    aria-valuenow=\"25\"\n    aria-valuetext=\"25 seats\"\n  />\n  <input type=\"hidden\" name=\"asientos-plan\" value=\"25\" />\n  <div class=\"ts slider-marks\"><span>5 seats</span> <span>250 seats</span></div>\n</div>"
  },
  {
    "titulo": "Text per stop",
    "html": "<div\n  class=\"ts slider size-md\"\n  data-ts-slider=\"\"\n  data-ts-slider-format=\"{v} seats\"\n  data-ts-slider-values=\"5,25,100\"\n  data-ts-slider-valuetexts=\"5 seats, Free|25 seats, Pro|100 seats, Enterprise\"\n>\n  <div class=\"ts slider-header\">\n    <label class=\"ts slider-label\" id=\"ts-slider-s6-label\" for=\"ts-slider-s6\">Plan</label>\n    <span class=\"ts slider-value\" data-ts-slider-value=\"\">25 seats</span>\n  </div>\n  <div class=\"ts slider-ticks\" aria-hidden=\"true\"><span></span><span></span><span></span></div>\n  <input\n    id=\"ts-slider-s6\"\n    type=\"range\"\n    class=\"ts slider-track size-md\"\n    min=\"0\"\n    max=\"2\"\n    step=\"1\"\n    value=\"1\"\n    aria-label=\"Plan\"\n    aria-valuemin=\"5\"\n    aria-valuemax=\"100\"\n    aria-valuenow=\"25\"\n    aria-valuetext=\"25 seats, Pro\"\n  />\n</div>"
  }
]
