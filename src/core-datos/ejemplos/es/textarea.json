[
  {
    "titulo": "Comentario con placeholder",
    "html": "<div class=\"ts input-wrapper\">\n  <label for=\"ts-textarea-s1\" class=\"ts input-label\">Comentario</label>\n  <div class=\"ts textarea size-md\" data-ts-textarea=\"\">\n    <textarea\n      id=\"ts-textarea-s1\"\n      rows=\"4\"\n      placeholder=\"Contanos qué te pareció\"\n      class=\"ts textarea-field\"\n    ></textarea>\n    <div class=\"ts textarea-actions\">\n      <span class=\"ts textarea-spinner\" data-ts-field-spinner=\"\" hidden=\"\"\n        ><span class=\"ts spinner size-sm\" role=\"status\" aria-label=\"Cargando...\"></span\n      ></span>\n    </div>\n  </div>\n</div>"
  },
  {
    "titulo": "Limpiable",
    "html": "<div class=\"ts input-wrapper\">\n  <label for=\"ts-textarea-s2\" class=\"ts input-label\">Nota del despliegue</label>\n  <div class=\"ts textarea size-md has-clear\" data-ts-textarea=\"\">\n    <textarea id=\"ts-textarea-s2\" rows=\"3\" class=\"ts textarea-field\">\nDespliegue completado.</textarea>\n    <div class=\"ts textarea-actions\">\n      <span class=\"ts textarea-spinner\" data-ts-field-spinner=\"\" hidden=\"\"\n        ><span class=\"ts spinner size-sm\" role=\"status\" aria-label=\"Cargando...\"></span\n      ></span>\n      <button\n        type=\"button\"\n        class=\"ts button size-xs variant-tertiary shape-square is-icon-only textarea-clear\"\n        aria-label=\"Limpiar campo\"\n        data-ts-clear=\"\"\n      >\n        <span data-ts-spinner=\"\"><span class=\"ts spinner size-sm\" aria-hidden=\"true\"></span></span>\n        <span data-ts-content=\"\">\n          <svg\n            xmlns=\"http://www.w3.org/2000/svg\"\n            width=\"16\"\n            height=\"16\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n            stroke-linecap=\"round\"\n            stroke-linejoin=\"round\"\n            class=\"ts icon icon-16\"\n          >\n            <path d=\"M18 6 6 18\" />\n            <path d=\"m6 6 12 12\" />\n          </svg>\n        </span>\n      </button>\n    </div>\n  </div>\n</div>"
  },
  {
    "titulo": "Cargando",
    "html": "<div class=\"ts input-wrapper\">\n  <label for=\"ts-textarea-s3\" class=\"ts input-label\">Descripción del proyecto</label>\n  <div class=\"ts textarea size-md has-clear is-loading\" data-ts-textarea=\"\">\n    <textarea id=\"ts-textarea-s3\" rows=\"2\" class=\"ts textarea-field\" aria-busy=\"true\">\nPanel de control</textarea>\n    <div class=\"ts textarea-actions\">\n      <span class=\"ts textarea-spinner\" data-ts-field-spinner=\"\"\n        ><span class=\"ts spinner size-sm\" role=\"status\" aria-label=\"Cargando...\"></span\n      ></span>\n      <button\n        type=\"button\"\n        class=\"ts button size-xs variant-tertiary shape-square is-icon-only textarea-clear\"\n        aria-label=\"Limpiar campo\"\n        data-ts-clear=\"\"\n      >\n        <span data-ts-spinner=\"\"><span class=\"ts spinner size-sm\" aria-hidden=\"true\"></span></span>\n        <span data-ts-content=\"\">\n          <svg\n            xmlns=\"http://www.w3.org/2000/svg\"\n            width=\"16\"\n            height=\"16\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n            stroke-linecap=\"round\"\n            stroke-linejoin=\"round\"\n            class=\"ts icon icon-16\"\n          >\n            <path d=\"M18 6 6 18\" />\n            <path d=\"m6 6 12 12\" />\n          </svg>\n        </span>\n      </button>\n    </div>\n  </div>\n</div>"
  },
  {
    "titulo": "Redimensionable en ambos ejes",
    "html": "<div class=\"ts input-wrapper\">\n  <label for=\"ts-textarea-s4\" class=\"ts input-label\">Notas del release</label>\n  <div class=\"ts textarea size-md resize-both\" data-ts-textarea=\"\">\n    <textarea id=\"ts-textarea-s4\" rows=\"2\" class=\"ts textarea-field\">\nNueva versión disponible.</textarea>\n    <div class=\"ts textarea-actions\">\n      <span class=\"ts textarea-spinner\" data-ts-field-spinner=\"\" hidden=\"\"\n        ><span class=\"ts spinner size-sm\" role=\"status\" aria-label=\"Cargando...\"></span\n      ></span>\n    </div>\n  </div>\n</div>"
  },
  {
    "titulo": "Comentario que espera a que termine la escritura",
    "html": "<div class=\"ts input-wrapper\">\n  <label for=\"ts-textarea-s5\" class=\"ts input-label\">Comentario del equipo</label>\n  <div class=\"ts textarea size-md\" data-ts-textarea=\"\">\n    <textarea\n      id=\"ts-textarea-s5\"\n      rows=\"2\"\n      class=\"ts textarea-field\"\n      data-ts-debounce=\"200\"\n    ></textarea>\n    <div class=\"ts textarea-actions\">\n      <span class=\"ts textarea-spinner\" data-ts-field-spinner=\"\" hidden=\"\"\n        ><span class=\"ts spinner size-sm\" role=\"status\" aria-label=\"Cargando...\"></span\n      ></span>\n    </div>\n  </div>\n</div>"
  }
