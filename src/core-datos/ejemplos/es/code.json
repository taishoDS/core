ed-icon=\"\"\n          ><svg\n            xmlns=\"http://www.w3.org/2000/svg\"\n            width=\"14\"\n            height=\"14\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n            stroke-linecap=\"round\"\n            stroke-linejoin=\"round\"\n            class=\"ts icon icon-14\"\n          >\n            <path d=\"M20 6 9 17l-5-5\" /></svg\n        ></template>\n      </span>\n    </button>\n    <span class=\"ts sr-only\" role=\"status\" aria-live=\"polite\" data-ts-copy-status=\"\"></span>\n  </div>\n  <div\n    id=\"ts-code-pestanas-panel-npm\"\n    role=\"tabpanel\"\n    aria-labelledby=\"ts-code-pestanas-tab-npm\"\n    data-ts-tabs-panel=\"\"\n    data-ts-value=\"npm\"\n    class=\"ts code-content\"\n    tabindex=\"0\"\n  >\n    <pre><code>npm i -D @taishods/core</code></pre>\n  </div>\n  <div\n    id=\"ts-code-pestanas-panel-pnpm\"\n    role=\"tabpanel\"\n    aria-labelledby=\"ts-code-pestanas-tab-pnpm\"\n    data-ts-tabs-panel=\"\"\n    data-ts-value=\"pnpm\"\n    class=\"ts code-content\"\n    tabindex=\"0\"\n  >\n    <pre><code>pnpm add -D @taishods/core</code></pre>\n  </div>\n</div>"
