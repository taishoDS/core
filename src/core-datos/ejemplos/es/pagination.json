    "titulo": "Lista larga de proyectos, 20 páginas",
    "html": "<nav\n  class=\"ts pagination size-md\"\n  aria-label=\"Navegación de páginas\"\n  data-ts-pagination=\"\"\n  data-ts-total=\"20\"\n  data-ts-page=\"1\"\n  data-ts-items=\"200\"\n  data-ts-page-size=\"10\"\n  data-ts-label-template=\"{from}–{to} de {total}\"\n  data-ts-label-empty=\"0 resultados\"\n>\n  <button\n    type=\"button\"\n    disabled=\"\"\n    class=\"ts button size-sm variant-secondary shape-square is-icon-only pagination-btn\"\n    data-ts-page-prev=\"\"\n    aria-label=\"Página anterior\"\n  >\n    <span data-ts-spinner=\"\"><span class=\"ts spinner size-sm\" aria-hidden=\"true\"></span></span>\n    <span data-ts-content=\"\">\n      <svg\n        xmlns=\"http://www.w3.org/2000/svg\"\n        width=\"16\"\n        height=\"16\"\n        viewBox=\"0 0 24 24\"\n        fill=\"none\"\n        stroke=\"currentColor\"\n        stroke-width=\"2\"\n        stroke-linecap=\"round\"\n        stroke-linejoin=\"round\"\n        class=\"ts icon icon-16\"\n      >\n        <path d=\"m15 18-6-6 6-6\" />\n      </svg>\n    </span>\n  </button>\n  <div data-ts-pagination-list=\"\">\n    <button\n      type=\"button\"\n      class=\"ts button size-sm variant-secondary pagination-btn is-active\"\n      data-ts-page-item=\"\"\n      data-ts-value=\"1\"\n      aria-label=\"Página 1\"\n      aria-current=\"page\"\n    >\n      <span data-ts-spinner=\"\"><span class=\"ts spinner size-sm\" aria-hidden=\"true\"></span></span>\n      <span data-ts-content=\"\"> 1 </span></button\n    ><button\n      type=\"button\"\n      class=\"ts button size-sm variant-secondary pagination-btn\"\n      data-ts-page-item=\"\"\n      data-ts-value=\"2\"\n      aria-label=\"Página 2\"\n    >\n      <span data-ts-spinner=\"\"><span class=\"ts spinner size-sm\" aria-hidden=\"true\"></span></span>\n      <span data-ts-content=\"\"> 2 </span></button\n    ><span class=\"ts pagination-ellipsis\" aria-hidden=\"true\" data-ts-page-ellipsis=\"\">…</span\n    ><button\n      type=\"button