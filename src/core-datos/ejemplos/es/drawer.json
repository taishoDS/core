[
  {
    "titulo": "Panel lateral de filtros",
    "html": "<button\n  type=\"button\"\n  class=\"ts button size-md variant-primary\"\n  commandfor=\"ts-drawer-demo\"\n  command=\"show-modal\"\n>\n  Abrir el panel\n</button>\n<dialog\n  id=\"ts-drawer-demo\"\n  closedby=\"any\"\n  class=\"ts drawer-dialog side-right\"\n  aria-labelledby=\"ts-drawer-title-s1\"\n>\n  <div class=\"ts drawer side-right size-md\">\n    <div class=\"ts modal-header\">\n      <h2 id=\"ts-drawer-title-s1\" class=\"ts modal-title\">Filtros</h2>\n      <button\n        type=\"button\"\n        class=\"ts button size-sm variant-tertiary shape-square is-icon-only flex-shrink-0\"\n        aria-label=\"Cerrar\"\n        commandfor=\"ts-drawer-demo\"\n        command=\"close\"\n      >\n        <span data-ts-spinner=\"\"><span class=\"ts spinner size-sm\" aria-hidden=\"true\"></span></span>\n        <span data-ts-content=\"\">\n          <svg\n            xmlns=\"http://www.w3.org/2000/svg\"\n            width=\"18\"\n            height=\"18\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n            stroke-linecap=\"round\"\n            stroke-linejoin=\"round\"\n            class=\"ts icon icon-18\"\n          >\n            <path d=\"M18 6 6 18\" />\n            <path d=\"m6 6 12 12\" />\n          </svg>\n        </span>\n      </button>\n    </div>\n    <div class=\"ts modal-body\">\n      <p class=\"ts type-copy-14\">Mostrando los despliegues de Producción y Staging.</p>\n    </div>\n  </div>\n</dialog>"
  },
  {
    "titulo": "No descartable con nombre propio",
    "html": "<button\n  type=\"button\"\n  class=\"ts button size-md variant-secondary\"\n  commandfor=\"ts-drawer-cola\"\n  command=\"show-modal\"\n>\n  Ver la cola de despliegues\n</button>\n<dialog\n  id=\"ts-drawer-cola\"\n  closedby=\"none\"\n  class=\"ts drawer-dialog side-left\"\n  aria-label=\"Cola de despliegues\"\n>\n  <div class=\"ts drawer side-left size-md\">\n    <div class=\"ts modal-body\">\n      <p class=\"ts type-copy-14\">\n        En cola: «App móvil» en Staging. Construyendo: «API de pagos» en Producción.\n      </p>\n    </div>\n    <div class=\"ts modal-footer\">\n      <button\n        type=\"button\"\n        class=\"ts button size-md variant-primary\"\n        commandfor=\"ts-drawer-cola\"\n        command=\"close\"\n      >\n        Listo\n      </button>\n    </div>\n  </div>\n</dialog>"
  }
]
