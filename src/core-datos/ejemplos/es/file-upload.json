[
  {
    "titulo": "Adjuntos múltiples con tope de tamaño",
    "html": "<div\n  class=\"ts file-upload\"\n  data-ts-file-upload=\"\"\n  data-ts-max-size=\"2000000\"\n  data-ts-file-error-size=\"Demasiado grande (máx. 1.9 MB)\"\n>\n  <input\n    type=\"file\"\n    data-ts-file-input=\"\"\n    class=\"ts sr-only\"\n    tabindex=\"-1\"\n    aria-label=\"Adjuntos\"\n    accept=\"\"\n    multiple=\"\"\n  />\n  <div class=\"ts file-upload-zone\">\n    <div class=\"ts file-upload-icon\">\n      <svg\n        xmlns=\"http://www.w3.org/2000/svg\"\n        width=\"32\"\n        height=\"32\"\n        viewBox=\"0 0 24 24\"\n        fill=\"none\"\n        stroke=\"currentColor\"\n        stroke-width=\"2\"\n        stroke-linecap=\"round\"\n        stroke-linejoin=\"round\"\n        class=\"ts icon icon-32\"\n      >\n        <path d=\"M12 3v12\" />\n        <path d=\"m17 8-5-5-5 5\" />\n        <path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\" />\n      </svg>\n    </div>\n    <p class=\"ts file-upload-title\">Arrastrar archivos aquí o usar el botón</p>\n    <p class=\"ts file-upload-hint\">Adjuntos</p>\n    <p class=\"ts file-upload-hint\">Hasta 2 MB por archivo</p>\n    <button type=\"button\" class=\"ts button size-sm variant-secondary\" data-ts-file-trigger=\"\">\n      <span data-ts-spinner=\"\"><span class=\"ts spinner size-sm\" aria-hidden=\"true\"></span></span>\n      <span data-ts-content=\"\"\n        ><span data-ts-icon-prefix=\"\"\n          ><svg\n            xmlns=\"http://www.w3.org/2000/svg\"\n            width=\"16\"\n            height=\"16\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n            stroke-linecap=\"round\"\n            stroke-linejoin=\"round\"\n            class=\"ts icon icon-16\"\n          >\n            <path d=\"M12 3v12\" />\n            <path d=\"m17 8-5-5-5 5\" />\n            <path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\" /></svg\n        ></span>\n        Seleccionar archivos\n      </span>\n    </button>\n  </div>\n  <ul class=\"ts file-upload-list\" role=\"list\" data-ts-file-list=\"\" hidden=\"\"></ul>\n  <template data-ts-file-template=\"\"\n    ><li class=\"ts file-upload-item\">\n      <svg\n        xmlns=\"http://www.w3.org/2000/svg\"\n        width=\"20\"\n        height=\"20\"\n        viewBox=\"0 0 24 24\"\n        fill=\"none\"\n        stroke=\"currentColor\"\n        stroke-width=\"2\"\n        stroke-linecap=\"round\"\n        stroke-linejoin=\"round\"\n        class=\"ts icon icon-20\"\n      >\n        <path\n          d=\"M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z\"\n        />\n        <path d=\"M14 2v5a1 1 0 0 0 1 1h5\" />\n      </svg>\n      <div data-file-info=\"\"><span data-file-name=\"\"></span> <span data-file-size=\"\"></span></div>\n      <button\n        type=\"button\"\n        class=\"ts button size-xs variant-tertiary shape-square is-icon-only flex-shrink-0\"\n        data-file-remove=\"true\"\n        aria-label=\"Quitar {nombre}\"\n      >\n        <span data-ts-spinner=\"\"><span class=\"ts spinner size-sm\" aria-hidden=\"true\"></span></span>\n        <span data-ts-content=\"\">\n          <svg\n            xmlns=\"http://www.w3.org/2000/svg\"\n            width=\"14\"\n            height=\"14\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n            stroke-linecap=\"round\"\n            stroke-linejoin=\"round\"\n            class=\"ts icon icon-14\"\n          >\n            <path d=\"M18 6 6 18\" />\n            <path d=\"m6 6 12 12\" />\n          </svg>\n        </span>\n      </button></li\n  ></template>\n  <template data-ts-file-error-icon=\"\"\n    ><svg\n      xmlns=\"http://www.w3.org/2000/svg\"\n      width=\"20\"\n      height=\"20\"\n      viewBox=\"0 0 24 24\"\n      fill=\"none\"\n      stroke=\"currentColor\"\n      stroke-width=\"2\"\n      stroke-linecap=\"round\"\n      stroke-linejoin=\"round\"\n      class=\"ts icon icon-20\"\n    >\n      <circle cx=\"12\" cy=\"12\" r=\"10\" />\n      <line x1=\"12\" x2=\"12\" y1=\"8\" y2=\"12\" />\n      <line x1=\"12\" x2=\"12.01\" y1=\"16\" y2=\"16\" /></svg\n  ></template>\n</div>"
  }
]
