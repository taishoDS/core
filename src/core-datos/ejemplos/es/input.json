  {
    "titulo": "Con error",
    "html": "<div class=\"ts input-wrapper\">\n  <label for=\"ts-input-s3\" class=\"ts input-label\">Usuario</label>\n  <div class=\"ts input size-md variant-danger\" data-ts-input=\"\">\n    <input\n      id=\"ts-input-s3\"\n      value=\"ada\"\n      type=\"text\"\n      class=\"ts input-field\"\n      aria-invalid=\"true\"\n      aria-describedby=\"ts-input-s3-hint\"\n    />\n    <div class=\"ts input-actions\">\n      <span class=\"ts input-loading\" data-ts-field-spinner=\"\" hidden=\"\"\n        ><span class=\"ts spinner size-sm\" role=\"status\" aria-label=\"Cargando...\"></span\n      ></span>\n    </div>\n  </div>\n  <div class=\"ts input-footer\">\n    <div id=\"ts-input-s3-hint\" class=\"ts input-hint variant-danger\" aria-live=\"polite\">\n      <svg\n        xmlns=\"http://www.w3.org/2000/svg\"\n        width=\"14\"\n        height=\"14\"\n        viewBox=\"0 0 24 24\"\n        fill=\"none\"\n        stroke=\"currentColor\"\n        stroke-width=\"2\"\n        stroke-linecap=\"round\"\n        stroke-linejoin=\"round\"\n        class=\"ts icon icon-14\"\n      >\n        <circle cx=\"12\" cy=\"12\" r=\"10\" />\n        <line x1=\"12\" x2=\"12\" y1=\"8\" y2=\"12\" />\n        <line x1=\"12\" x2=\"12.01\" y1=\"16\" y2=\"16\" />\n      </svg>\n      <span>Ya está tomado.</span>\n    </div>\n  </div>\n</div>"
