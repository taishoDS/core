    "titulo": "Aviso de plan descartable",
    "html": "<div class=\"ts banner variant-info\" role=\"region\" aria-label=\"Aviso\" data-ts-dismissible=\"\">\n  <span data-banner-icon=\"\" class=\"ts color-info\"\n    ><svg\n      xmlns=\"http://www.w3.org/2000/svg\"\n      width=\"16\"\n      height=\"16\"\n      viewBox=\"0 0 24 24\"\n      fill=\"none\"\n      stroke=\"currentColor\"\n      stroke-width=\"2\"\n      stroke-linecap=\"round\"\n      stroke-linejoin=\"round\"\n      class=\"ts icon icon-16\"\n    >\n      <circle cx=\"12\" cy=\"12\" r=\"10\" />\n      <path d=\"M12 16v-4\" />\n      <path d=\"M12 8h.01\" /></svg\n  ></span>\n  <div data-banner-content=\"\"><span>Tu plan vence en 5 días.</span></div>\n  <button\n    type=\"button\"\n    class=\"ts button size-xs variant-ghost shape-square is-icon-only flex-shrink-0 is-color-inherit\"\n    data-banner-close=\"true\"\n    data-ts-dismiss=\"\"\n    aria-label=\"Cerrar\"\n  >\n    <span data-ts-spinner=\"\"><span class=\"ts spinner size-sm\" aria-hidden=\"true\"></span></span>\n    <span data-ts-content=\"\">\n      <svg\n        xmlns=\"http://www.w3.org/2000/svg\"\n        width=\"14\"\n        height=\"14\"\n        viewBox=\"0 0 24 24\"\n        fill=\"none\"\n        stroke=\"currentColor\"\n        stroke-width=\"2\"\n        stroke-linecap=\"round\"\n        stroke-linejoin=\"round\"\n        class=\"ts icon icon-14\"\n      >\n        <path d=\"M18 6 6 18\" />\n        <path d=\"m6 6 12 12\" />\n      </svg>\n    </span>\n  </button>\n</div>"
  }
