[
  {
    "titulo": "Confirmación con acciones",
    "html": "<button\n  type=\"button\"\n  class=\"ts button size-md variant-primary\"\n  commandfor=\"ts-modal-demo\"\n  command=\"show-modal\"\n>\n  Invitar a Ana Torres\n</button>\n<dialog\n  id=\"ts-modal-demo\"\n  closedby=\"any\"\n  class=\"ts modal-dialog\"\n  aria-labelledby=\"ts-modal-title-s1\"\n>\n  <div class=\"ts modal size-md\">\n    <div class=\"ts modal-header\">\n      <h2 id=\"ts-modal-title-s1\" class=\"ts modal-title\">Invitar a Ana Torres al equipo</h2>\n      <button\n        type=\"button\"\n        class=\"ts button size-sm variant-tertiary shape-square is-icon-only flex-shrink-0\"\n        aria-label=\"Cerrar\"\n        commandfor=\"ts-modal-demo\"\n        command=\"close\"\n      >\n        <span data-ts-spinner=\"\"><span class=\"ts spinner size-sm\" aria-hidden=\"true\"></span></span>\n        <span data-ts-content=\"\">\n          <svg\n            xmlns=\"http://www.w3.org/2000/svg\"\n            width=\"18\"\n            height=\"18\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n            stroke-linecap=\"round\"\n            stroke-linejoin=\"round\"\n            class=\"ts icon icon-18\"\n          >\n            <path d=\"M18 6 6 18\" />\n            <path d=\"m6 6 12 12\" />\n          </svg>\n        </span>\n      </button>\n    </div>\n    <div class=\"ts modal-body\">\n      <p class=\"ts type-copy-14\">Va a poder ver y editar los proyectos de Producción y Staging.</p>\n    </div>\n    <div class=\"ts modal-footer\">\n      <button\n        type=\"button\"\n        class=\"ts button size-md variant-secondary\"\n        commandfor=\"ts-modal-demo\"\n        command=\"close\"\n      >\n        Cancelar\n      </button>\n      <button\n        type=\"button\"\n        class=\"ts button size-md variant-primary\"\n        commandfor=\"ts-modal-demo\"\n        command=\"close\"\n      >\n        Invitar\n      </button>\n    </div>\n  </div>\n</dialog>"
  },
  {
    "titulo": "Modal con foco inicial, hoja en pantallas chicas",
    "html": "<button\n  type=\"button\"\n  class=\"ts button size-md variant-secondary\"\n  commandfor=\"ts-modal-rename\"\n  command=\"show-modal\"\n>\n  Renombrar el proyecto\n</button>\n<dialog\n  id=\"ts-modal-rename\"\n  closedby=\"any\"\n  class=\"ts modal-dialog responsive-sheet\"\n  aria-labelledby=\"ts-modal-title-s2\"\n>\n  <div class=\"ts modal size-md\">\n    <div class=\"ts modal-header\">\n      <h2 id=\"ts-modal-title-s2\" class=\"ts modal-title\">Renombrar el proyecto</h2>\n      <button\n        type=\"button\"\n        class=\"ts button size-sm variant-tertiary shape-square is-icon-only flex-shrink-0\"\n        aria-label=\"Cerrar\"\n        commandfor=\"ts-modal-rename\"\n        command=\"close\"\n      >\n        <span data-ts-spinner=\"\"><span class=\"ts spinner size-sm\" aria-hidden=\"true\"></span></span>\n        <span data-ts-content=\"\">\n          <svg\n            xmlns=\"http://www.w3.org/2000/svg\"\n            width=\"18\"\n            height=\"18\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n            stroke-linecap=\"round\"\n            stroke-linejoin=\"round\"\n            class=\"ts icon icon-18\"\n          >\n            <path d=\"M18 6 6 18\" />\n            <path d=\"m6 6 12 12\" />\n          </svg>\n        </span>\n      </button>\n    </div>\n    <div class=\"ts modal-body\">\n      <div class=\"ts input-wrapper\">\n        <label class=\"ts input-label\" for=\"ts-modal-rename-nombre\">Nombre del proyecto</label>\n        <div class=\"ts input size-md variant-default\">\n          <input\n            id=\"ts-modal-rename-nombre\"\n            class=\"ts input-field\"\n            value=\"Panel de control\"\n            autofocus=\"\"\n          />\n        </div>\n      </div>\n    </div>\n  </div>\n</dialog>"
  },
  {
    "titulo": "Header propio con nombre accesible",
    "html": "<button\n  type=\"button\"\n  class=\"ts button size-md variant-secondary\"\n  commandfor=\"ts-modal-plan\"\n  command=\"show-modal\"\n>\n  Cambiar de plan\n</button>\n<dialog\n  id=\"ts-modal-plan\"\n  closedby=\"any\"\n  class=\"ts modal-dialog\"\n  aria-labelledby=\"ts-modal-plan-titulo\"\n>\n  <div class=\"ts modal size-md\">\n    <div class=\"ts modal-header\">\n      <div class=\"ts flex flex-col gap-quarter\">\n        <h2 id=\"ts-modal-plan-titulo\" class=\"ts modal-title\">Cambiar al plan Pro</h2>\n        <p class=\"ts type-copy-14 color-subtle\">Panel de control</p>\n      </div>\n      <button\n        type=\"button\"\n        class=\"ts button size-sm variant-tertiary shape-square is-icon-only flex-shrink-0\"\n        aria-label=\"Cerrar\"\n        commandfor=\"ts-modal-plan\"\n        command=\"close\"\n      >\n        <span data-ts-spinner=\"\"><span class=\"ts spinner size-sm\" aria-hidden=\"true\"></span></span>\n        <span data-ts-content=\"\">\n          <svg\n            xmlns=\"http://www.w3.org/2000/svg\"\n            width=\"18\"\n            height=\"18\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n            stroke-linecap=\"round\"\n            stroke-linejoin=\"round\"\n            class=\"ts icon icon-18\"\n          >\n            <path d=\"M18 6 6 18\" />\n            <path d=\"m6 6 12 12\" />\n          </svg>\n        </span>\n      </button>\n    </div>\n    <div class=\"ts modal-body\">\n      <p class=\"ts type-copy-14\">El cambio se aplica en el próximo ciclo de facturación.</p>\n    </div>\n  </div>\n</dialog>"
  },
  {
    "titulo": "No descartable",
    "html": "<button\n  type=\"button\"\n  class=\"ts button size-md variant-secondary\"\n  commandfor=\"ts-modal-despliegue\"\n  command=\"show-modal\"\n>\n  Ver el despliegue en curso\n</button>\n<dialog\n  id=\"ts-modal-despliegue\"\n  closedby=\"none\"\n  class=\"ts modal-dialog\"\n  aria-label=\"Despliegue en curso\"\n>\n  <div class=\"ts modal size-md\">\n    <div class=\"ts modal-body\">\n      <p class=\"ts type-copy-14\">\n        Construyendo «API de pagos» en Producción. Esta ventana queda abierta hasta que termine.\n      </p>\n    </div>\n    <div class=\"ts modal-footer\">\n      <button\n        type=\"button\"\n        class=\"ts button size-md variant-primary\"\n        commandfor=\"ts-modal-despliegue\"\n        command=\"close\"\n      >\n        Entendido\n      </button>\n    </div>\n  </div>\n</dialog>"
  }
]
