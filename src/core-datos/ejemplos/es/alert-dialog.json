[
  {
    "titulo": "Confirmación para borrar la cuenta",
    "html": "<button\n  type=\"button\"\n  class=\"ts button size-md variant-danger\"\n  commandfor=\"ts-alert-demo\"\n  command=\"show-modal\"\n>\n  Borrar la cuenta\n</button>\n<dialog\n  id=\"ts-alert-demo\"\n  role=\"alertdialog\"\n  class=\"ts modal-dialog\"\n  aria-labelledby=\"ts-alertdialog-title-s1\"\n  aria-describedby=\"ts-alertdialog-body-s1\"\n>\n  <div class=\"ts modal size-sm\">\n    <div class=\"ts modal-header\">\n      <h2 id=\"ts-alertdialog-title-s1\" class=\"ts modal-title\">¿Borrar la cuenta?</h2>\n    </div>\n    <div id=\"ts-alertdialog-body-s1\" class=\"ts modal-body\">\n      Esto no se puede deshacer. Se van a perder todos tus proyectos.\n    </div>\n    <div class=\"ts modal-footer\">\n      <button\n        type=\"button\"\n        class=\"ts button size-md variant-secondary\"\n        data-ts-safe=\"\"\n        commandfor=\"ts-alert-demo\"\n        command=\"close\"\n      >\n        <span data-ts-spinner=\"\"><span class=\"ts spinner size-sm\" aria-hidden=\"true\"></span></span>\n        <span data-ts-content=\"\"> Cancelar </span>\n      </button>\n      <button\n        type=\"button\"\n        class=\"ts button size-md variant-danger\"\n        commandfor=\"ts-alert-demo\"\n        command=\"close\"\n      >\n        <span data-ts-spinner=\"\"><span class=\"ts spinner size-sm\" aria-hidden=\"true\"></span></span>\n        <span data-ts-content=\"\"> Sí, borrar </span>\n      </button>\n    </div>\n  </div>\n</dialog>"
  },
  {
    "titulo": "Confirmar tipeando el nombre del proyecto",
    "html": "<button\n  type=\"button\"\n  class=\"ts button size-md variant-danger\"\n  commandfor=\"ts-alert-text-demo\"\n  command=\"show-modal\"\n>\n  Eliminar proyecto\n</button>\n<dialog\n  id=\"ts-alert-text-demo\"\n  role=\"alertdialog\"\n  class=\"ts modal-dialog\"\n  aria-labelledby=\"ts-alertdialog-title-s2\"\n  aria-describedby=\"ts-alertdialog-body-s2\"\n  data-ts-confirm-text=\"Panel de control\"\n>\n  <div class=\"ts modal size-sm\">\n    <div class=\"ts modal-header\">\n      <h2 id=\"ts-alertdialog-title-s2\" class=\"ts modal-title\">¿Eliminar el proyecto?</h2>\n    </div>\n    <div class=\"ts modal-body flex flex-col gap-base\">\n      <div id=\"ts-alertdialog-body-s2\">\n        Se borran los despliegues y las claves de «Panel de control». Esto no se puede deshacer.\n      </div>\n      <div class=\"ts input-wrapper\">\n        <label for=\"ts-input-s3\" class=\"ts input-label\"\n          >Escribir «Panel de control» para confirmar</label\n        >\n        <div class=\"ts input size-md variant-default\" data-ts-input=\"\">\n          <input\n            id=\"ts-input-s3\"\n            value=\"\"\n            type=\"text\"\n            class=\"ts input-field\"\n            autocomplete=\"off\"\n            data-ts-confirm-input=\"\"\n          />\n          <div class=\"ts input-actions\">\n            <span class=\"ts input-loading\" data-ts-field-spinner=\"\" hidden=\"\"\n              ><span class=\"ts spinner size-sm\" role=\"status\" aria-label=\"Cargando...\"></span\n            ></span>\n          </div>\n        </div>\n      </div>\n    </div>\n    <div class=\"ts modal-footer\">\n      <button\n        type=\"button\"\n        class=\"ts button size-md variant-secondary\"\n        data-ts-safe=\"\"\n        commandfor=\"ts-alert-text-demo\"\n        command=\"close\"\n      >\n        <span data-ts-spinner=\"\"><span class=\"ts spinner size-sm\" aria-hidden=\"true\"></span></span>\n        <span data-ts-content=\"\"> Cancelar </span>\n      </button>\n      <button\n        type=\"button\"\n        disabled=\"\"\n        class=\"ts button size-md variant-danger\"\n        data-ts-confirm=\"\"\n        commandfor=\"ts-alert-text-demo\"\n        command=\"close\"\n      >\n        <span data-ts-spinner=\"\"><span class=\"ts spinner size-sm\" aria-hidden=\"true\"></span></span>\n        <span data-ts-content=\"\"> Eliminar definitivamente </span>\n      </button>\n    </div>\n  </div>\n</dialog>"
  },
  {
    "titulo": "Nombre propio más descriptivo",
    "html": "<button\n  type=\"button\"\n  class=\"ts button size-md variant-danger\"\n  commandfor=\"ts-alert-nombre-demo\"\n  command=\"show-modal\"\n>\n  Quitar a Carla Ruiz\n</button>\n<dialog\n  id=\"ts-alert-nombre-demo\"\n  role=\"alertdialog\"\n  class=\"ts modal-dialog\"\n  aria-label=\"Quitar a Carla Ruiz del proyecto Sitio marketing\"\n  aria-describedby=\"ts-alertdialog-body-s4\"\n>\n  <div class=\"ts modal size-sm\">\n    <div class=\"ts modal-header\">\n      <h2 id=\"ts-alertdialog-title-s4\" class=\"ts modal-title\">¿Quitar a Carla Ruiz?</h2>\n    </div>\n    <div id=\"ts-alertdialog-body-s4\" class=\"ts modal-body\">\n      Pierde el acceso a «Sitio marketing». Se puede invitar de nuevo cuando haga falta.\n    </div>\n    <div class=\"ts modal-footer\">\n      <button\n        type=\"button\"\n        class=\"ts button size-md variant-secondary\"\n        data-ts-safe=\"\"\n        commandfor=\"ts-alert-nombre-demo\"\n        command=\"close\"\n      >\n        <span data-ts-spinner=\"\"><span class=\"ts spinner size-sm\" aria-hidden=\"true\"></span></span>\n        <span data-ts-content=\"\"> Cancelar </span>\n      </button>\n      <button\n        type=\"button\"\n        class=\"ts button size-md variant-danger\"\n        commandfor=\"ts-alert-nombre-demo\"\n        command=\"close\"\n      >\n        <span data-ts-spinner=\"\"><span class=\"ts spinner size-sm\" aria-hidden=\"true\"></span></span>\n        <span data-ts-content=\"\"> Quitar </span>\n      </button>\n    </div>\n  </div>\n</dialog>"
  }
]
