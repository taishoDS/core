[
  {
    "titulo": "Notification on save",
    "html": "<button\n  type=\"button\"\n  class=\"ts button size-md variant-primary\"\n  data-ts-toast-trigger=\"Changes saved.\"\n  data-ts-toast-variant=\"success\"\n>\n  Save changes\n</button>\n<div\n  class=\"ts toaster position-bottom-right\"\n  data-ts-toast-container=\"\"\n  data-ts-toast-dismiss-label=\"Close notification\"\n  popover=\"manual\"\n>\n  <div data-ts-toast-region=\"polite\" role=\"status\" aria-live=\"polite\" aria-atomic=\"false\"></div>\n  <div\n    data-ts-toast-region=\"assertive\"\n    role=\"alert\"\n    aria-live=\"assertive\"\n    aria-atomic=\"false\"\n  ></div>\n  <template data-ts-toast-icon=\"success\"\n    ><span data-toast-icon=\"\" class=\"ts color-success\"\n      ><svg\n        xmlns=\"http://www.w3.org/2000/svg\"\n        width=\"16\"\n        height=\"16\"\n        viewBox=\"0 0 24 24\"\n        fill=\"none\"\n        stroke=\"currentColor\"\n        stroke-width=\"2\"\n        stroke-linecap=\"round\"\n        stroke-linejoin=\"round\"\n        class=\"ts icon icon-16\"\n      >\n        <circle cx=\"12\" cy=\"12\" r=\"10\" />\n        <path d=\"m16 9-5.5 5.5L8 12\" /></svg></span></template\n  ><template data-ts-toast-icon=\"warning\"\n    ><span data-toast-icon=\"\" class=\"ts color-warning\"\n      ><svg\n        xmlns=\"http://www.w3.org/2000/svg\"\n        width=\"16\"\n        height=\"16\"\n        viewBox=\"0 0 24 24\"\n        fill=\"none\"\n        stroke=\"currentColor\"\n        stroke-width=\"2\"\n        stroke-linecap=\"round\"\n        stroke-linejoin=\"round\"\n        class=\"ts icon icon-16\"\n      >\n        <path d=\"m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3\" />\n        <path d=\"M12 9v4\" />\n        <path d=\"M12 17h.01\" /></svg></span></template\n  ><template data-ts-toast-icon=\"info\"\n    ><span data-toast-icon=\"\" class=\"ts color-info\"\n      ><svg\n        xmlns=\"http://www.w3.org/2000/svg\"\n        width=\"16\"\n        height=\"16\"\n        viewBox=\"0 0 24 24\"\n        fill=\"none\"\n        stroke=\"currentColor\"\n        stroke-width=\"2\"\n        stroke-linecap=\"round\"\n        stroke-linejoin=\"round\"\n        class=\"ts icon icon-16\"\n      >\n        <circle cx=\"12\" cy=\"12\" r=\"10\" />\n        <path d=\"M12 16v-4\" />\n        <path d=\"M12 8h.01\" /></svg></span></template\n  ><template data-ts-toast-icon=\"danger\"\n    ><span data-toast-icon=\"\" class=\"ts color-danger\"\n      ><svg\n        xmlns=\"http://www.w3.org/2000/svg\"\n        width=\"16\"\n        height=\"16\"\n        viewBox=\"0 0 24 24\"\n        fill=\"none\"\n        stroke=\"currentColor\"\n        stroke-width=\"2\"\n        stroke-linecap=\"round\"\n        stroke-linejoin=\"round\"\n        class=\"ts icon icon-16\"\n      >\n        <circle cx=\"12\" cy=\"12\" r=\"10\" />\n        <line x1=\"12\" x2=\"12\" y1=\"8\" y2=\"12\" />\n        <line x1=\"12\" x2=\"12.01\" y1=\"16\" y2=\"16\" /></svg></span\n  ></template>\n  <template data-ts-toast-icon=\"loading\"\n    ><span data-toast-icon=\"\" aria-hidden=\"true\"\n      ><span class=\"ts spinner size-sm\" role=\"status\" aria-label=\"Loading\"></span></span\n  ></template>\n</div>"
  }
]
