[
  {
    "titulo": "Confirmation with actions",
    "html": "<button\n  type=\"button\"\n  class=\"ts button size-md variant-primary\"\n  commandfor=\"ts-modal-demo\"\n  command=\"show-modal\"\n>\n  Invite Ana Torres\n</button>\n<dialog\n  id=\"ts-modal-demo\"\n  closedby=\"any\"\n  class=\"ts modal-dialog\"\n  aria-labelledby=\"ts-modal-title-s1\"\n>\n  <div class=\"ts modal size-md\">\n    <div class=\"ts modal-header\">\n      <h2 id=\"ts-modal-title-s1\" class=\"ts modal-title\">Invite Ana Torres to the team</h2>\n      <button\n        type=\"button\"\n        class=\"ts button size-sm variant-tertiary shape-square is-icon-only flex-shrink-0\"\n        aria-label=\"Close\"\n        commandfor=\"ts-modal-demo\"\n        command=\"close\"\n      >\n        <span data-ts-spinner=\"\"><span class=\"ts spinner size-sm\" aria-hidden=\"true\"></span></span>\n        <span data-ts-content=\"\">\n          <svg\n            xmlns=\"http://www.w3.org/2000/svg\"\n            width=\"18\"\n            height=\"18\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n            stroke-linecap=\"round\"\n            stroke-linejoin=\"round\"\n            class=\"ts icon icon-18\"\n          >\n            <path d=\"M18 6 6 18\" />\n            <path d=\"m6 6 12 12\" />\n          </svg>\n        </span>\n      </button>\n    </div>\n    <div class=\"ts modal-body\">\n      <p class=\"ts type-copy-14\">\n        She’ll be able to view and edit the Production and Staging projects.\n      </p>\n    </div>\n    <div class=\"ts modal-footer\">\n      <button\n        type=\"button\"\n        class=\"ts button size-md variant-secondary\"\n        commandfor=\"ts-modal-demo\"\n        command=\"close\"\n      >\n        Cancel\n      </button>\n      <button\n        type=\"button\"\n        class=\"ts button size-md variant-primary\"\n        commandfor=\"ts-modal-demo\"\n        command=\"close\"\n      >\n        Invite\n      </button>\n    </div>\n  </div>\n</dialog>"
  },
  {
    "titulo": "Modal with initial focus, sheet on small screens",
    "html": "<button\n  type=\"button\"\n  class=\"ts button size-md variant-secondary\"\n  commandfor=\"ts-modal-rename\"\n  command=\"show-modal\"\n>\n  Rename the project\n</button>\n<dialog\n  id=\"ts-modal-rename\"\n  closedby=\"any\"\n  class=\"ts modal-dialog responsive-sheet\"\n  aria-labelledby=\"ts-modal-title-s2\"\n>\n  <div class=\"ts modal size-md\">\n    <div class=\"ts modal-header\">\n      <h2 id=\"ts-modal-title-s2\" class=\"ts modal-title\">Rename the project</h2>\n      <button\n        type=\"button\"\n        class=\"ts button size-sm variant-tertiary shape-square is-icon-only flex-shrink-0\"\n        aria-label=\"Close\"\n        commandfor=\"ts-modal-rename\"\n        command=\"close\"\n      >\n        <span data-ts-spinner=\"\"><span class=\"ts spinner size-sm\" aria-hidden=\"true\"></span></span>\n        <span data-ts-content=\"\">\n          <svg\n            xmlns=\"http://www.w3.org/2000/svg\"\n            width=\"18\"\n            height=\"18\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n            stroke-linecap=\"round\"\n            stroke-linejoin=\"round\"\n            class=\"ts icon icon-18\"\n          >\n            <path d=\"M18 6 6 18\" />\n            <path d=\"m6 6 12 12\" />\n          </svg>\n        </span>\n      </button>\n    </div>\n    <div class=\"ts modal-body\">\n      <div class=\"ts input-wrapper\">\n        <label class=\"ts input-label\" for=\"ts-modal-rename-nombre\">Project name</label>\n        <div class=\"ts input size-md variant-default\">\n          <input\n            id=\"ts-modal-rename-nombre\"\n            class=\"ts input-field\"\n            value=\"Dashboard\"\n            autofocus=\"\"\n          />\n        </div>\n      </div>\n    </div>\n  </div>\n</dialog>"
  },
  {
    "titulo": "Custom header with an accessible name",
    "html": "<button\n  type=\"button\"\n  class=\"ts button size-md variant-secondary\"\n  commandfor=\"ts-modal-plan\"\n  command=\"show-modal\"\n>\n  Change plan\n</button>\n<dialog\n  id=\"ts-modal-plan\"\n  closedby=\"any\"\n  class=\"ts modal-dialog\"\n  aria-labelledby=\"ts-modal-plan-titulo\"\n>\n  <div class=\"ts modal size-md\">\n    <div class=\"ts modal-header\">\n      <div class=\"ts flex flex-col gap-quarter\">\n        <h2 id=\"ts-modal-plan-titulo\" class=\"ts modal-title\">Switch to the Pro plan</h2>\n        <p class=\"ts type-copy-14 color-subtle\">Dashboard</p>\n      </div>\n      <button\n        type=\"button\"\n        class=\"ts button size-sm variant-tertiary shape-square is-icon-only flex-shrink-0\"\n        aria-label=\"Close\"\n        commandfor=\"ts-modal-plan\"\n        command=\"close\"\n      >\n        <span data-ts-spinner=\"\"><span class=\"ts spinner size-sm\" aria-hidden=\"true\"></span></span>\n        <span data-ts-content=\"\">\n          <svg\n            xmlns=\"http://www.w3.org/2000/svg\"\n            width=\"18\"\n            height=\"18\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n            stroke-linecap=\"round\"\n            stroke-linejoin=\"round\"\n            class=\"ts icon icon-18\"\n          >\n            <path d=\"M18 6 6 18\" />\n            <path d=\"m6 6 12 12\" />\n          </svg>\n        </span>\n      </button>\n    </div>\n    <div class=\"ts modal-body\">\n      <p class=\"ts type-copy-14\">The change applies on the next billing cycle.</p>\n    </div>\n  </div>\n</dialog>"
  },
  {
    "titulo": "Not dismissible",
    "html": "<button\n  type=\"button\"\n  class=\"ts button size-md variant-secondary\"\n  commandfor=\"ts-modal-despliegue\"\n  command=\"show-modal\"\n>\n  View the running deployment\n</button>\n<dialog\n  id=\"ts-modal-despliegue\"\n  closedby=\"none\"\n  class=\"ts modal-dialog\"\n  aria-label=\"Deployment in progress\"\n>\n  <div class=\"ts modal size-md\">\n    <div class=\"ts modal-body\">\n      <p class=\"ts type-copy-14\">\n        Building “Payments API” in Production. This window stays open until it finishes.\n      </p>\n    </div>\n    <div class=\"ts modal-footer\">\n      <button\n        type=\"button\"\n        class=\"ts button size-md variant-primary\"\n        commandfor=\"ts-modal-despliegue\"\n        command=\"close\"\n      >\n        Got it\n      </button>\n    </div>\n  </div>\n</dialog>"
  }
]
