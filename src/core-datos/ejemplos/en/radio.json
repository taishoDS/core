[
  {
    "titulo": "Plan group",
    "html": "<div class=\"ts flex flex-col gap-y-half\" role=\"radiogroup\" aria-label=\"Choose a plan\">\n  <label for=\"ts-radio-s2\" class=\"ts radio size-md variant-primary\"\n    ><input type=\"radio\" id=\"ts-radio-s2\" name=\"plan\" value=\"individual\" class=\"ts radio-input\" />\n    <div class=\"ts radio-box\"><div class=\"ts radio-dot\"></div></div>\n    <span class=\"ts radio-label\">Individual</span></label\n  >\n  <label for=\"ts-radio-s3\" class=\"ts radio size-md variant-primary is-checked\"\n    ><input\n      type=\"radio\"\n      id=\"ts-radio-s3\"\n      name=\"plan\"\n      checked=\"\"\n      value=\"equipo\"\n      class=\"ts radio-input\"\n    />\n    <div class=\"ts radio-box\"><div class=\"ts radio-dot\"></div></div>\n    <span class=\"ts radio-label\">Team</span></label\n  >\n  <label for=\"ts-radio-s4\" class=\"ts radio size-md variant-primary\"\n    ><input type=\"radio\" id=\"ts-radio-s4\" name=\"plan\" value=\"empresa\" class=\"ts radio-input\" />\n    <div class=\"ts radio-box\"><div class=\"ts radio-dot\"></div></div>\n    <span class=\"ts radio-label\">Company</span></label\n  >\n</div>"
  },
  {
    "titulo": "Environments with descriptions",
    "html": "<div class=\"ts input-wrapper\">\n  <span id=\"ts-radio-group-root-s5-label\" class=\"ts input-label\">Environment</span>\n  <div\n    class=\"ts flex flex-col gap-y-half\"\n    role=\"radiogroup\"\n    aria-labelledby=\"ts-radio-group-root-s5-label\"\n    aria-describedby=\"ts-radio-group-root-s5-hint\"\n  >\n    <label for=\"ts-radio-s6\" class=\"ts radio size-md variant-primary has-description\"\n      ><input\n        type=\"radio\"\n        id=\"ts-radio-s6\"\n        name=\"entorno\"\n        value=\"produccion\"\n        aria-labelledby=\"ts-radio-s6-label\"\n        aria-describedby=\"ts-radio-s6-description\"\n        class=\"ts radio-input\"\n      />\n      <div class=\"ts radio-box\"><div class=\"ts radio-dot\"></div></div>\n      <span class=\"ts radio-card-body\"\n        ><span id=\"ts-radio-s6-label\" class=\"ts radio-label\">Production</span>\n        <span id=\"ts-radio-s6-description\" class=\"ts radio-description\"\n          >Visible to the whole team.</span\n        >\n      </span></label\n    >\n    <label for=\"ts-radio-s7\" class=\"ts radio size-md variant-primary is-checked has-description\"\n      ><input\n        type=\"radio\"\n        id=\"ts-radio-s7\"\n        name=\"entorno\"\n        checked=\"\"\n        value=\"staging\"\n        aria-labelledby=\"ts-radio-s7-label\"\n        aria-describedby=\"ts-radio-s7-description\"\n        class=\"ts radio-input\"\n      />\n      <div class=\"ts radio-box\"><div class=\"ts radio-dot\"></div></div>\n      <span class=\"ts radio-card-body\"\n        ><span id=\"ts-radio-s7-label\" class=\"ts radio-label\">Staging</span>\n        <span id=\"ts-radio-s7-description\" class=\"ts radio-description\"\n          >For review before publishing.</span\n        >\n      </span></label\n    >\n    <label for=\"ts-radio-s8\" class=\"ts radio size-md variant-primary is-disabled\"\n      ><input\n        type=\"radio\"\n        id=\"ts-radio-s8\"\n        name=\"entorno\"\n        disabled=\"\"\n        value=\"desarrollo\"\n        class=\"ts radio-input\"\n      />\n      <div class=\"ts radio-box\"><div class=\"ts radio-dot\"></div></div>\n      <span class=\"ts radio-label\">Development</span></label\n    >\n  </div>\n  <div class=\"ts input-footer\">\n    <div id=\"ts-radio-group-root-s5-hint\" class=\"ts input-hint variant-default\">\n      <span>You can change it on every deployment.</span>\n    </div>\n  </div>\n</div>"
  },
  {
    "titulo": "Options as cards",
    "html": "<div class=\"ts input-wrapper\">\n  <span id=\"ts-radio-group-root-s9-label\" class=\"ts input-label\">Billing</span>\n  <div\n    class=\"ts flex flex-col gap-y-half\"\n    role=\"radiogroup\"\n    aria-labelledby=\"ts-radio-group-root-s9-label\"\n  >\n    <label for=\"ts-radio-s10\" class=\"ts radio size-md variant-primary is-card has-description\"\n      ><input\n        type=\"radio\"\n        id=\"ts-radio-s10\"\n        name=\"facturacion\"\n        value=\"mensual\"\n        aria-labelledby=\"ts-radio-s10-label\"\n        aria-describedby=\"ts-radio-s10-description\"\n        class=\"ts radio-input\"\n      />\n      <div class=\"ts radio-box\"><div class=\"ts radio-dot\"></div></div>\n      <span class=\"ts radio-card-body\"\n        ><span id=\"ts-radio-s10-label\" class=\"ts radio-label\">Monthly</span>\n        <span id=\"ts-radio-s10-description\" class=\"ts radio-description\"\n          >You pay month to month.</span\n        >\n      </span></label\n    >\n    <label\n      for=\"ts-radio-s11\"\n      class=\"ts radio size-md variant-primary is-checked is-card has-description\"\n      ><input\n        type=\"radio\"\n        id=\"ts-radio-s11\"\n        name=\"facturacion\"\n        checked=\"\"\n        value=\"anual\"\n        aria-labelledby=\"ts-radio-s11-label\"\n        aria-describedby=\"ts-radio-s11-description\"\n        class=\"ts radio-input\"\n      />\n      <div class=\"ts radio-box\"><div class=\"ts radio-dot\"></div></div>\n      <span class=\"ts radio-card-body\"\n        ><span id=\"ts-radio-s11-label\" class=\"ts radio-label\">Yearly</span>\n        <span id=\"ts-radio-s11-description\" class=\"ts radio-description\">Two months free.</span>\n      </span></label\n    >\n  </div>\n</div>"
  },
  {
    "titulo": "Required with error",
    "html": "<div class=\"ts input-wrapper\">\n  <span id=\"ts-radio-group-root-s12-label\" class=\"ts input-label\"\n    >Your plan<span class=\"ts required-indicator\" aria-hidden=\"true\">*</span></span\n  >\n  <div\n    class=\"ts flex flex-col gap-y-half\"\n    role=\"radiogroup\"\n    aria-labelledby=\"ts-radio-group-root-s12-label\"\n    aria-describedby=\"ts-radio-group-root-s12-hint\"\n    aria-invalid=\"true\"\n    aria-required=\"true\"\n  >\n    <label for=\"ts-radio-s13\" class=\"ts radio size-md variant-danger is-invalid\"\n      ><input\n        type=\"radio\"\n        id=\"ts-radio-s13\"\n        name=\"plan-error\"\n        required=\"\"\n        value=\"free\"\n        class=\"ts radio-input\"\n      />\n      <div class=\"ts radio-box\"><div class=\"ts radio-dot\"></div></div>\n      <span class=\"ts radio-label\">Free</span></label\n    >\n    <label for=\"ts-radio-s14\" class=\"ts radio size-md variant-danger is-invalid\"\n      ><input\n        type=\"radio\"\n        id=\"ts-radio-s14\"\n        name=\"plan-error\"\n        required=\"\"\n        value=\"pro\"\n        class=\"ts radio-input\"\n      />\n      <div class=\"ts radio-box\"><div class=\"ts radio-dot\"></div></div>\n      <span class=\"ts radio-label\">Pro</span></label\n    >\n    <label for=\"ts-radio-s15\" class=\"ts radio size-md variant-danger is-invalid\"\n      ><input\n        type=\"radio\"\n        id=\"ts-radio-s15\"\n        name=\"plan-error\"\n        required=\"\"\n        value=\"enterprise\"\n        class=\"ts radio-input\"\n      />\n      <div class=\"ts radio-box\"><div class=\"ts radio-dot\"></div></div>\n      <span class=\"ts radio-label\">Enterprise</span></label\n    >\n  </div>\n  <div class=\"ts input-footer\">\n    <div id=\"ts-radio-group-root-s12-hint\" class=\"ts input-hint variant-danger\" aria-live=\"polite\">\n      <svg\n        xmlns=\"http://www.w3.org/2000/svg\"\n        width=\"14\"\n        height=\"14\"\n        viewBox=\"0 0 24 24\"\n        fill=\"none\"\n        stroke=\"currentColor\"\n        stroke-width=\"2\"\n        stroke-linecap=\"round\"\n        stroke-linejoin=\"round\"\n        class=\"ts icon icon-14\"\n      >\n        <circle cx=\"12\" cy=\"12\" r=\"10\" />\n        <line x1=\"12\" x2=\"12\" y1=\"8\" y2=\"12\" />\n        <line x1=\"12\" x2=\"12.01\" y1=\"16\" y2=\"16\" />\n      </svg>\n      <span>Choose a plan to continue.</span>\n    </div>\n  </div>\n</div>"
  }
