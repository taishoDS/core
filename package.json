	},
	"dependencies": {
		"jiti": "^2.7.0"
	},
	"devDependencies": {
		"@fontsource/geist-mono": "^5.3.0",
		"@fontsource/geist-sans": "^5.3.0",
		"@playwright/test": "^1.64.0",
		"@testing-library/jest-dom": "^8.0.0",
		"@types/node": "^26.6.6",
		"axe-core": "^4.13.0",
		"esbuild": "^0.28.2",
		"jsdom": "^30.1.2",
		"lucide-static": "^1.70.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"vite": "^8.3.4",
		"vitest": "^5.1.0",
