{
  // Sólo para emitir los .d.ts del paquete `@taishods/core` (scripts/build-core-package.ts).
  // Va aparte del tsconfig del repo porque acota la compilación a las DOS entradas
  // públicas del Core: si alguna arrastrara algo de Svelte, esto fallaría acá y no en la
  // máquina de quien lo instale.
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist-core/types",
    "rootDir": "src",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "target": "es2022",
    "strict": true,
    "skipLibCheck": true,
    "types": [],
    "paths": {
      "@taishods/core/density": ["./src/lib/theme/density.ts"],
      "@taishods/core/motion-scale": ["./src/lib/theme/motion-scale.ts"],
      "@taishods/core/color": ["./src/generate/color.ts"]
    }
  },
  "include": ["src/lib/core/auto.ts", "src/lib/theme/createTheme.ts", "src/lib/theme/density.ts", "src/lib/theme/motion-scale.ts", "src/generate/color.ts"]
}
